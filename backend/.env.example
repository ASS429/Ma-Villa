APP_NAME="PasseTemps"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# URL du front (SPA React) : cible des liens dans les emails transactionnels
# et des redirections après vérification d'adresse.
FRONTEND_URL=http://localhost:5173

# Origines autorisées par le CORS, séparées par des virgules.
# ⚠️ En production, sans cette variable, seul localhost est autorisé et le site
# ne peut plus appeler l'API. À définir AVANT le déploiement.
FRONTEND_URLS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# ── Stockage des photos ──────────────────────────────────────────────
# ⚠️ En production, MEDIA_DISK doit valoir s3 : le disque d'un conteneur est
# réinitialisé à chaque déploiement, et les photos des propriétaires seraient
# perdues (les lignes en base survivraient, les images renverraient 404).
# Cloudflare R2, Backblaze B2 et AWS S3 utilisent tous le pilote « s3 ».
MEDIA_DISK=public

# Exemple pour Cloudflare R2 :
# MEDIA_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET=passetemps-medias
# AWS_DEFAULT_REGION=auto
# AWS_ENDPOINT=https://<compte>.r2.cloudflarestorage.com
# AWS_URL=https://medias.passetemps.sn        # domaine public du bucket
# AWS_USE_PATH_STYLE_ENDPOINT=true
#
# Après bascule, transférer les fichiers déjà en ligne :
#   php artisan passetemps:migrer-medias --simulation
#   php artisan passetemps:migrer-medias

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Emails transactionnels ───────────────────────────────────────────
# ⚠️ « log » n'envoie rien. Tant qu'un vrai transport n'est pas configuré,
# les confirmations de réservation, les refus et les réinitialisations de mot
# de passe ne partent pas — la boucle de réservation reste ouverte.
#
# Prestataires adaptés : Resend, Brevo, Postmark, Mailgun.
# Penser à publier SPF et DKIM sur le domaine expéditeur, sinon les messages
# arrivent en indésirables.
#
# Vérification : php artisan passetemps:diagnostic --email=vous@exemple.sn
# ⚠️ Le SMTP sortant est bloqué chez l'hébergeur (port 587 fermé depuis le
# conteneur) : la sonde /admin/courriel le constate en douze secondes. Un
# service qui expédie en HTTP passe, lui, par le port 443 comme le reste.
#
#   MAIL_MAILER=resend
#   RESEND_API_KEY=re_xxxxxxxxxxxx
#
# L'adresse d'expédition doit appartenir à un domaine vérifié chez le service,
# faute de quoi il refuse d'expédier en son nom.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contactsmavilla@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Paiement en ligne ────────────────────────────────────────────────
# Wave et Orange Money sont annoncés dans l'interface mais volontairement
# inactifs : la stratégie d'encaissement n'est pas arrêtée. Tant que ce
# drapeau vaut false, aucun parcours de paiement n'est proposé et les
# réservations se règlent directement avec le propriétaire.
PAIEMENT_ACTIF=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
